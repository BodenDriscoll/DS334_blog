ggplot(data = pred_cars, aes(x = hp, y = predicted)) +
geom_line(aes(color = wt)) +
geom_ribbon(data = pred_cars, aes(y = predicted,
ymin = conf.low,
ymax = conf.high,
fill = wt),
alpha = 0.2) +
geom_point(data = mtcars, aes(y = mpg, color = wt), alpha = 0.3) +
scale_fill_viridis_d() +
scale_color_viridis_d()
